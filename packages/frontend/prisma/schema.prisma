// =============================================================================
// Prisma Schema — Remont.by
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// Enums
// =============================================================================

enum Role {
  CUSTOMER
  CONTRACTOR
}

enum OrderStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// =============================================================================
// Models
// =============================================================================

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password_hash  String
  role           Role      @default(CUSTOMER)
  first_name     String?
  last_name      String?
  phone          String?
  avatar_url     String?
  city_id        Int?
  city           City?     @relation(fields: [city_id], references: [id])
  about          String?   @db.Text
  experience_years Int?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  skills            ContractorSkill[]
  portfolio         Portfolio[]
  orders            Order[]
  responses         OrderResponse[]
  reviews_given     Review[]          @relation("ReviewAuthor")
  reviews_received  Review[]          @relation("ReviewTarget")
  favorites         Favorite[]
  favorited_by      Favorite[]        @relation("FavoritedContractor")
  user_subscriptions UserSubscription[]
  messages_sent     Message[]         @relation("MessageSender")
  messages_received Message[]         @relation("MessageReceiver")

  @@map("users")
}

model Region {
  id         Int    @id @default(autoincrement())
  name       String
  slug       String @unique
  sort_order Int    @default(0)
  cities     City[]

  @@map("regions")
}

model City {
  id         Int    @id @default(autoincrement())
  name       String
  slug       String @unique
  region_id  Int
  region     Region @relation(fields: [region_id], references: [id])
  sort_order Int    @default(0)
  users      User[]

  @@map("cities")
}

model Category {
  id         Int      @id @default(autoincrement())
  parent_id  Int?
  parent     Category? @relation("CategoryTree", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryTree")
  name       String
  slug       String   @unique
  metadata   Json     @default("{}")
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  skills    ContractorSkill[]
  portfolio Portfolio[]
  orders    Order[]
  reviews   Review[]

  @@map("categories")
}


model ContractorSkill {
  id            Int      @id @default(autoincrement())
  contractor_id Int
  contractor    User     @relation(fields: [contractor_id], references: [id])
  category_id   Int
  category      Category @relation(fields: [category_id], references: [id])
  rating        Float    @default(0)
  reviews_count Int      @default(0)
  created_at    DateTime @default(now())

  @@unique([contractor_id, category_id])
  @@map("contractor_skills")
}

model Portfolio {
  id            Int      @id @default(autoincrement())
  contractor_id Int
  contractor    User     @relation(fields: [contractor_id], references: [id], onDelete: Cascade)
  category_id   Int
  category      Category @relation(fields: [category_id], references: [id])
  photo_url     String
  description   String?  @db.Text
  created_at    DateTime @default(now())

  @@map("portfolio")
}

model Order {
  id                  Int            @id @default(autoincrement())
  customer_id         Int
  customer            User           @relation(fields: [customer_id], references: [id])
  category_id         Int
  category            Category       @relation(fields: [category_id], references: [id])
  title               String
  description         String         @db.Text
  project_description String?        @db.Text
  budget_min          Int?
  budget_max          Int?
  deadline            DateTime?
  city_id             Int?
  city                City?          @relation(fields: [city_id], references: [id])
  address             String?
  status              OrderStatus    @default(OPEN)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  responses           OrderResponse[]
  reviews             Review[]

  @@map("orders")
}

model OrderResponse {
  id            Int            @id @default(autoincrement())
  order_id      Int
  order         Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  contractor_id Int
  contractor    User           @relation(fields: [contractor_id], references: [id])
  price_offer   Int?
  message       String?        @db.Text
  status        ResponseStatus @default(PENDING)
  created_at    DateTime       @default(now())

  @@unique([order_id, contractor_id])
  @@map("order_responses")
}

model Review {
  id            Int       @id @default(autoincrement())
  order_id      Int
  order         Order     @relation(fields: [order_id], references: [id])
  customer_id   Int
  customer      User      @relation("ReviewAuthor", fields: [customer_id], references: [id])
  contractor_id Int
  contractor    User      @relation("ReviewTarget", fields: [contractor_id], references: [id])
  category_id   Int
  category      Category  @relation(fields: [category_id], references: [id])
  rating        Int
  text          String?   @db.Text
  created_at    DateTime  @default(now())

  @@map("reviews")
}

model Message {
  id          Int      @id @default(autoincrement())
  sender_id   Int
  sender      User     @relation("MessageSender", fields: [sender_id], references: [id])
  receiver_id Int
  receiver    User     @relation("MessageReceiver", fields: [receiver_id], references: [id])
  order_id    Int?
  text        String   @db.Text
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())

  @@map("messages")
}



