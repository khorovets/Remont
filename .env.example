# =============================================================================
# Переменные окружения — Remont
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями для окружения.
# .env НЕ коммитится (добавлен в .gitignore)
# =============================================================================

# --- База данных (Prisma + PostgreSQL) ---
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://remont:remont@localhost:5432/remont

# --- JWT-аутентификация (jose) ---
# Секретный ключ для подписи токенов. В production — случайная строка >= 32 символов
JWT_SECRET=your-secret-key-change-in-production
# Время жизни токена (ms-нотация: 7d, 24h, 60m и т.д.)
JWT_EXPIRES_IN=7d

# --- Публичный API (Next.js) ---
# URL API-эндпоинтов, доступный на клиенте (префикс NEXT_PUBLIC_ обязателен для Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# --- Загрузка файлов ---
# Директория для загружаемых файлов (относительно корня frontend-пакета)
UPLOAD_DIR=public/uploads
# Максимальный размер файла в байтах (5 MB = 5 * 1024 * 1024)
MAX_UPLOAD_SIZE=5242880
